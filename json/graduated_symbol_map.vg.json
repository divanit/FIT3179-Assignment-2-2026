{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 380,
  "background": "transparent",
  "config": {
    "font": "Inter, -apple-system, BlinkMacSystemFont, sans-serif",
    "axis": {
      "titleFont": "Inter, -apple-system, BlinkMacSystemFont, sans-serif",
      "titleFontSize": 12,
      "titleFontWeight": "bold",
      "labelFont": "Inter, -apple-system, BlinkMacSystemFont, sans-serif",
      "labelFontSize": 12
    },
    "legend": {
      "titleFont": "Inter, -apple-system, BlinkMacSystemFont, sans-serif",
      "titleFontSize": 12,
      "titleFontWeight": "bold",
      "labelFont": "Inter, -apple-system, BlinkMacSystemFont, sans-serif",
      "labelFontSize": 12
    },
    "view": {
      "stroke": null
    }
  },
  "padding": { "left": 10, "right": 80, "top": 10, "bottom": 10 },
  "projection": {
    "type": "mercator",
    "center": [133, -28],
    "scale": 520
  },
  "params": [
    {
      "name": "Year_Selection",
      "value": 2020,
      "bind": {
        "input": "select",
        "options": [2005, 2010, 2015, 2020],
        "labels": ["2005", "2010", "2015", "2020"],
        "name": "Year: "
      }
    }
  ],
  "layer": [
    {
      "data": {
        "url": "https://raw.githubusercontent.com/FIT3179/Vega-Lite/main/7_others/oceans.topojson",
        "format": {"type": "topojson", "feature": "oceans"}
      },
      "mark": {"type": "geoshape", "fill": "skyblue"}
    },
    {
      "data": {
        "url": "json/country_map.json",
        "format": {
          "type": "topojson",
          "feature": "ne_10m_admin_0_countries"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#e8e8e8",
        "stroke": "black",
        "strokeWidth": 0.5
      }
    },
    {
      "data": {
        "url": "data/varietal_concentration_processed.csv"
      },
      "transform": [
        {
          "fold": ["VCI2005", "VCI2010", "VCI2015", "VCI2020"],
          "as": ["year_col", "vci"]
        },
        {
          "calculate": "replace(datum.year_col, 'VCI', '')",
          "as": "year"
        },
        {
          "calculate": "toNumber(datum.vci)",
          "as": "vci_num"
        },
        {
          "filter": "datum.year == Year_Selection && datum.vci_num > 0"
        }
      ],
      "mark": {
        "type": "circle",
        "opacity": 0.60,
        "fill": "#b16dff",
        "stroke": "black",
        "strokeWidth": 0.75
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "size": {
          "field": "vci_num",
          "type": "quantitative",
          "title": ["Varietal Concentration", "Index (VCI)"],
          "scale": {
            "type": "sqrt",
            "domain": [10, 60],
            "range": [20, 400]
          }
        },
        "tooltip": [
          {"field": "region", "type": "nominal", "title": "Region"},
          {"field": "year", "type": "ordinal", "title": "Year"},
          {"field": "vci_num", "type": "quantitative", "title": "VCI", "format": ","}
        ]
      }
    }
  ]
}